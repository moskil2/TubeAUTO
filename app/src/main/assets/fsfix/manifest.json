{
  "manifest_version": 2,
  "name": "TubeAUTO - poprawka pełnego ekranu",
  "version": "1.1",
  "browser_specific_settings": {
    "gecko": { "id": "fsfix@youtubeauto.app" }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
